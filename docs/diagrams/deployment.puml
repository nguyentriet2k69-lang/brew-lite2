@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50
title BrewLite — Vercel + Render Deployment

actor "Customer browser\nMobile / PWA" as customer

package "LOCAL / TESTING — Docker Compose" {
  node "Developer machine / test runner" {
    artifact "Next.js web\napps/web :3000" as localweb
    artifact "NestJS API\napps/api :3001" as localapi
    database "Local / isolated test PostgreSQL" as localdb
  }
  localweb --> localapi : HTTP
  localapi --> localdb : SQL
}

package "CI/CD — GitHub Actions" {
  cloud "Repository\nbrew-lite2" as repo
  node "Verify job" as verify {
    artifact "Install / Lint / Unit\nPostgreSQL Integration + API E2E\nBuild API + Web" as checks
    database "Ephemeral test PostgreSQL" as testdb
  }
  node "Production deploy job" as release {
    artifact "Render API deploy\ncommit SHA / poll / smoke" as renderdeploy
    artifact "Vercel CLI production deploy\npublic HTTPS smoke" as verceldeploy
    artifact "Protected GitHub Environment\nprovider secrets + IDs" as secrets
  }
}

cloud "Vercel" as vercel {
  artifact "Production Next.js project\napps/web\nNEXT_PUBLIC_API_URL" as web
}

cloud "Render" as render {
  node "NestJS Web Service\napps/api\nHealth: /health" as api
  database "Managed PostgreSQL\nInternal connection URL" as db
}

customer --> web : HTTPS web
customer --> api : HTTPS API / CORS
web --> api : HTTPS API requests
api --> db : Private/internal SQL
repo --> verify : PR / main / release tag
verify --> testdb : Integration + E2E
verify --> release : Continue only on success
secrets --> release : Authorized deployment
renderdeploy --> api : Render API deploy + poll
verceldeploy --> web : Vercel CLI deploy
release --> api : HTTPS health/products smoke
release --> web : HTTPS page/manifest smoke

legend bottom
  Production: Vercel (web) + Render (API and managed PostgreSQL).
  Docker Compose is used only for local development and testing.
  The web browser does not connect directly to PostgreSQL.
  Provider database backups and migration policy depend on account configuration.
endlegend
@enduml
