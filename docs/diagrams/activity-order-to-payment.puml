@startuml
skinparam style strictuml
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #000000
skinparam ArrowColor #000000

title Activity Diagram: Order and payment (UC-05)

|Customer|
start
:Open cart and confirm checkout;

|Next.js UI|
if (Valid JWT?) then (No)
  :Redirect to sign-in;\nkeep cart;
  stop
else (Yes)
  :Create order Idempotency-Key;
  :POST /orders with JWT and cart;
endif

|NestJS API|
:Verify JWT and validate request;
|Database|
:Begin transaction;\nlock Products and calculate server prices;
if (Products exist and stock is sufficient?) then (No)
  :Rollback transaction;
  |Next.js UI|
  :Show validation/out-of-stock error;\nkeep cart;
  stop
else (Yes)
  :Decrement stock;\ncreate Order, OrderItems,\nHELD reservation;
  :Commit transaction;
endif

|Next.js UI|
:Create a separate payment Idempotency-Key;
:POST /payments with JWT, order ID and method;

|NestJS API|
:Verify ownership;\ncreate PaymentAttempt and set reservation PAYMENT_PENDING;
:Call payment mock outside DB transaction;

|Payment Mock|
if (Conclusive result?) then (Success)
  |Database|
  :Commit PaymentAttempt SUCCESS;\nOrder PAID; reservation CONSUMED;
  |Next.js UI|
  :Show confirmation;\nclear cart;
  stop
elseif (Confirmed failure)
  |Database|
  :Commit PaymentAttempt FAILED;\nrestore stock; reservation RELEASED;\nOrder PAYMENT_FAILED;
  |Next.js UI|
  :Show failure; keep cart;\nretry with a new payment key;
  stop
else (Timeout / unknown)
  |Database|
  :Persist UNKNOWN;\nkeep reservation PAYMENT_PENDING;
  |Next.js UI|
  :Show pending status;\nreconcile using the same payment key;
  stop
endif
@enduml
