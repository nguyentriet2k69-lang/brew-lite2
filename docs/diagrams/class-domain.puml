@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam nodesep 50
skinparam ranksep 50

title BrewLite domain model (implemented core + planned optional domain)

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentStatus {
  PROCESSING
  SUCCESS
  FAILED
  UNKNOWN
}

enum PaymentMethod {
  CARD
  WALLET
}

enum ReservationStatus {
  HELD
  PAYMENT_PENDING
  CONSUMED
  RELEASED
  EXPIRED
}

class User {
  - id: UUID
  - email: String
  - passwordHash: String
  - fullName: String
}

class Product {
  - id: UUID
  - name: String
  - basePrice: VND
  - stock: Int
}

class Order {
  - id: UUID
  - totalAmount: VND
  - status: OrderStatus
  - idempotencyKey: String
  - requestFingerprint: String
  - createdAt: DateTime
}

class OrderItem {
  - id: UUID
  - quantity: Int
  - unitPrice: VND
  - sizeSnapshot: JSON
  - toppingsSnapshot: JSON
}

class Payment {
  - id: UUID
  - orderId: UUID
  - reservationId: UUID
  - idempotencyKey: String
  - method: PaymentMethod
  - status: PaymentStatus
  - amount: VND
  - gatewayReference: String?
}

class InventoryReservation {
  - id: UUID
  - status: ReservationStatus
  - expiresAt: DateTime
}

class Promotion <<planned: FR-10>> {
  - id: UUID
  - code: String
  - discountPercent: Int
}

class LoyaltyTransaction <<planned: FR-10>> {
  - id: UUID
  - points: Int
  - type: String
}

User "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderItem : contains
Product "1" -- "0..*" OrderItem : referenced by
Order "1" -- "0..*" Payment : payment attempts
Order "1" *-- "1..*" InventoryReservation : reserves
User "1" -- "0..*" LoyaltyTransaction : earns
Promotion "0..1" -- "0..*" Order : applies to

note right of Payment
  Implemented by the PaymentAttempt
  entity/table; each retry is persisted.
end note
note bottom of Promotion
  Optional domain design only;
  not implemented in the current MVP.
end note
@enduml
