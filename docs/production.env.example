# RETIRED: legacy Ubuntu/Compose deployment template; not used by current Vercel/Render production.
# Do not copy this file into provider settings or treat it as an active production configuration.
WEB_DOMAIN=brew.example.com
API_DOMAIN=api.brew.example.com
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=replace-with-a-generated-url-safe-password
POSTGRES_DB=brewlite
DATABASE_URL=postgresql://brewlite:replace-with-a-generated-url-safe-password@db:5432/brewlite
JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
JWT_EXPIRES_IN=1d
CORS_ORIGIN=https://brew.example.com
MOCK_PAYMENT_RESULT=success
MOCK_PAYMENT_TIMEOUT=false
NEXT_PUBLIC_API_URL=https://api.brew.example.com
