# Copy to .env for local Docker Compose. Use a unique value outside local development.
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=local-only-change-this-password
POSTGRES_DB=brewlite
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgresql://brewlite:local-only-change-this-password@db:5432/brewlite
JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
MOCK_PAYMENT_RESULT=success
MOCK_PAYMENT_TIMEOUT=false

API_HOST_PORT=3001
WEB_HOST_PORT=3000
NEXT_PUBLIC_API_URL=http://api:3001
